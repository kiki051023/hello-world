<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.student.mapper.CourseMapper">

    <resultMap id="CourseResultMap" type="com.example.student.entity.Course">
        <id property="id" column="id"/>
        <result property="courseNo" column="course_no"/>
        <result property="courseName" column="course_name"/>
        <result property="credit" column="credit"/>
        <result property="teacherId" column="teacher_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="teacherName" column="teacher_name"/>
    </resultMap>

    <select id="selectCoursePage" resultMap="CourseResultMap">
        SELECT c.*, t.name AS teacher_name
        FROM course c
        LEFT JOIN teacher t ON c.teacher_id = t.id
        WHERE c.deleted = 0
        <if test="courseName != null and courseName != ''">
            AND c.course_name LIKE CONCAT('%', #{courseName}, '%')
        </if>
        <if test="teacherId != null">
            AND c.teacher_id = #{teacherId}
        </if>
        ORDER BY c.id DESC
    </select>

    <select id="selectCourseExport" resultType="java.util.HashMap">
        SELECT c.course_no AS courseNo, c.course_name AS courseName,
               c.credit AS credit, t.name AS teacherName
        FROM course c
        LEFT JOIN teacher t ON c.teacher_id = t.id
        WHERE c.deleted = 0
        <if test="courseName != null and courseName != ''">
            AND c.course_name LIKE CONCAT('%', #{courseName}, '%')
        </if>
        <if test="teacherId != null">
            AND c.teacher_id = #{teacherId}
        </if>
        ORDER BY c.id DESC
    </select>

</mapper>
