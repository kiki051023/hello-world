<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.student.mapper.CourseMapper">

    <resultMap id="CourseResultMap" type="com.example.student.entity.Course">
        <id property="id" column="id"/>
        <result property="courseNo" column="course_no"/>
        <result property="courseName" column="course_name"/>
        <result property="credit" column="credit"/>
        <result property="teacherId" column="teacher_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="teacherName" column="teacher_name"/>
    </resultMap>

    <sql id="courseScopePredicate">
        <if test="scope.teacherId != null">c.teacher_id = #{scope.teacherId} OR</if>
        <if test="scope.hasCourseIds and scope.courseIds.size() > 0">c.id IN <foreach collection="scope.courseIds" item="id" open="(" separator="," close=")">#{id}</foreach> OR</if>
        <if test="scope.departmentId != null">EXISTS (SELECT 1 FROM teacher t_scope WHERE t_scope.id = c.teacher_id AND t_scope.deleted = 0 AND t_scope.department_id = #{scope.departmentId}) OR</if>
        1=0
    </sql>

    <select id="selectCoursePage" resultMap="CourseResultMap">
        SELECT c.*, t.name AS teacher_name
        FROM course c
        LEFT JOIN teacher t ON c.teacher_id = t.id
        WHERE c.deleted = 0
        <if test="scope != null and !scope.unrestricted">
            AND ( <include refid="courseScopePredicate"/> )
        </if>
        <if test="courseName != null and courseName != ''">
            AND c.course_name LIKE CONCAT('%', #{courseName}, '%')
        </if>
        <if test="teacherId != null">
            AND c.teacher_id = #{teacherId}
        </if>
        ORDER BY c.id DESC
    </select>

    <select id="selectCourseExport" resultType="java.util.HashMap">
        SELECT c.course_no AS courseNo, c.course_name AS courseName,
               c.credit AS credit, t.name AS teacherName
        FROM course c
        LEFT JOIN teacher t ON c.teacher_id = t.id
        WHERE c.deleted = 0
        <if test="scope != null and !scope.unrestricted">
            AND ( <include refid="courseScopePredicate"/> )
        </if>
        <if test="courseName != null and courseName != ''">
            AND c.course_name LIKE CONCAT('%', #{courseName}, '%')
        </if>
        <if test="teacherId != null">
            AND c.teacher_id = #{teacherId}
        </if>
        ORDER BY c.id DESC
    </select>

    <select id="selectIdsByCourseNames" resultType="java.util.HashMap">
        SELECT id AS id, course_name AS courseName
        FROM course
        WHERE deleted = 0
        <if test="scope != null and !scope.unrestricted">
            AND (
                <if test="scope.teacherId != null">teacher_id = #{scope.teacherId} OR</if>
                <if test="scope.hasCourseIds and scope.courseIds.size() > 0">id IN <foreach collection="scope.courseIds" item="id" open="(" separator="," close=")">#{id}</foreach> OR</if>
                <if test="scope.departmentId != null">EXISTS (SELECT 1 FROM teacher t_scope WHERE t_scope.id = course.teacher_id AND t_scope.deleted = 0 AND t_scope.department_id = #{scope.departmentId}) OR</if>
                1=0
            )
        </if>
        AND course_name IN
        <foreach collection="courseNames" item="courseName" open="(" separator="," close=")">
            #{courseName}
        </foreach>
    </select>

</mapper>