<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.student.mapper.StudentMapper">

    <resultMap id="StudentResultMap" type="com.example.student.entity.Student">
        <id property="id" column="id"/>
        <result property="studentNo" column="student_no"/>
        <result property="name" column="name"/>
        <result property="gender" column="gender"/>
        <result property="birthday" column="birthday"/>
        <result property="phone" column="phone"/>
        <result property="address" column="address"/>
        <result property="clazzId" column="clazz_id"/>
        <result property="userId" column="user_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="clazzName" column="clazz_name"/>
    </resultMap>

    <select id="selectStudentPage" resultMap="StudentResultMap">
            SELECT s.*, c.clazz_name
            FROM student s
            LEFT JOIN clazz c ON s.clazz_id = c.id
            WHERE s.deleted = 0
            <if test="scope != null and !scope.unrestricted">
                AND (
                    <if test="scope.selfOnly">s.user_id = #{scope.userId} OR</if>
                    <if test="scope.departmentId != null">s.department_id = #{scope.departmentId} OR</if>
                    <if test="scope.hasClassIds and scope.classIds.size() > 0">s.clazz_id IN <foreach collection="scope.classIds" item="id" open="(" separator="," close=")">#{id}</foreach> OR</if>
                    <if test="scope.teacherId != null">EXISTS (SELECT 1 FROM score sc_scope JOIN course co_scope ON co_scope.id = sc_scope.course_id WHERE sc_scope.student_id = s.id AND sc_scope.deleted = 0 AND co_scope.teacher_id = #{scope.teacherId}) OR</if>
                    1=0
                )
            </if>
            <if test="name != null and name != ''">
                AND s.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="studentNo != null and studentNo != ''">
                AND s.student_no LIKE CONCAT('%', #{studentNo}, '%')
            </if>
            <if test="clazzId != null">
                AND s.clazz_id = #{clazzId}
            </if>
            ORDER BY s.id DESC
        </select>

        <select id="selectStudentExport" resultType="java.util.HashMap">
            SELECT s.student_no AS studentNo, s.name AS name, s.gender AS gender,
                   s.birthday AS birthday, s.phone AS phone,
                   c.clazz_name AS clazzName, s.address AS address
            FROM student s
            LEFT JOIN clazz c ON s.clazz_id = c.id
            WHERE s.deleted = 0
            <if test="scope != null and !scope.unrestricted">
                AND (
                    <if test="scope.selfOnly">s.user_id = #{scope.userId} OR</if>
                    <if test="scope.departmentId != null">s.department_id = #{scope.departmentId} OR</if>
                    <if test="scope.hasClassIds and scope.classIds.size() > 0">s.clazz_id IN <foreach collection="scope.classIds" item="id" open="(" separator="," close=")">#{id}</foreach> OR</if>
                    <if test="scope.teacherId != null">EXISTS (SELECT 1 FROM score sc_scope JOIN course co_scope ON co_scope.id = sc_scope.course_id WHERE sc_scope.student_id = s.id AND sc_scope.deleted = 0 AND co_scope.teacher_id = #{scope.teacherId}) OR</if>
                    1=0
                )
            </if>
            <if test="name != null and name != ''">
                AND s.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="studentNo != null and studentNo != ''">
                AND s.student_no = #{studentNo}
            </if>
            <if test="clazzId != null">
                AND s.clazz_id = #{clazzId}
            </if>
            ORDER BY s.id DESC
        </select>

        <select id="selectIdsByStudentNos" resultType="java.util.HashMap">
            SELECT id AS id, student_no AS studentNo
            FROM student
            WHERE deleted = 0
            <if test="scope != null and !scope.unrestricted">
                AND (
                    <if test="scope.selfOnly">user_id = #{scope.userId} OR</if>
                    <if test="scope.departmentId != null">department_id = #{scope.departmentId} OR</if>
                    <if test="scope.hasClassIds and scope.classIds.size() > 0">clazz_id IN <foreach collection="scope.classIds" item="id" open="(" separator="," close=")">#{id}</foreach> OR</if>
                    1=0
                )
            </if>
              AND student_no IN
            <foreach collection="studentNos" item="studentNo" open="(" separator="," close=")">
                #{studentNo}
            </foreach>
        </select>

</mapper>
